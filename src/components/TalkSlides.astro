---
import { suugakuto10 as talk } from '../data/suugakuto-10';
const { english = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const pdfHref = withBase(talk.pdfPath);
---
<section class="page-intro talk-intro">
  <p class="eyebrow">{talk.event} · 2026.10.12</p>
  <h1>{talk.title}</h1>
  <p class="talk-subtitle">{talk.subtitle}</p>
  <p class="talk-author">Alwe <span lang="en">(@Alwe_Logic)</span></p>
  <p class="talk-abstract"><a class="text-link" href={withBase(talk.abstractPath)} target="_blank" rel="noreferrer">{english ? 'Read the abstract (PDF) ↗' : '発表要旨を読む（PDF）↗'}</a></p>
</section>
<section class="section slides-section" aria-labelledby="slides-heading">
  <h2 id="slides-heading">{english ? 'Presentation slides' : '発表スライド'}</h2>
  <p class="slides-description">{english ? 'Slides in Japanese. Open the PDF to read it on your device, or download a copy.' : 'PDFをブラウザで閲覧、またはダウンロードできます。'}</p>
  <div class="slides-actions">
    <a class="button" href={pdfHref} target="_blank" rel="noreferrer">{english ? 'Open PDF ↗' : 'スライドを読む ↗'}</a>
    <a class="text-link" href={pdfHref} download="suugakuto-10-hott-groups.pdf">{english ? 'Download PDF' : 'PDFをダウンロード'}</a>
  </div>
  <details class="slides-preview">
    <summary>{english ? 'Preview on this page' : 'このページでプレビューする'}</summary>
    <object data={pdfHref} type="application/pdf" aria-label={english ? 'Presentation slides (Japanese PDF)' : '発表スライド（PDF）'}>
      {english ? 'If the preview is unavailable, use the Open PDF link above.' : 'プレビューを表示できない場合は、上の「スライドを読む」から開いてください。'}
    </object>
  </details>
</section>
<section class="section share-section" aria-labelledby="share-heading">
  <div>
    <h2 id="share-heading">{english ? 'Link to this page' : 'このページへのリンク'}</h2>
    <p>{english ? 'The QR code links to this page.' : 'QRコードからこのページを開けます。'}</p>
    <a class="text-link page-url" href={talk.publicUrl}>{talk.publicUrl}</a>
    <p class="qr-download"><a class="text-link" href={withBase(talk.qrPath)} download="suugakuto-10-page-qr.png">{english ? 'Download QR code (PNG)' : 'QRコードをダウンロード（PNG）'}</a></p>
  </div>
  <img class="page-qr" src={withBase(talk.qrPath)} width="200" height="200" alt={english ? 'QR code linking to this page' : 'このページへのQRコード'} loading="lazy" />
</section>
<style>
  .talk-intro { max-width: 900px; }
  .talk-intro .eyebrow { font-size: 14px; color: var(--warm); margin: 0 0 24px; }
  .talk-intro h1 { font-size: clamp(30px, 5vw, 52px); line-height: 1.5; letter-spacing: -.02em; }
  .talk-intro .talk-subtitle { margin-top: 16px; }
  .talk-intro .talk-author { margin-top: 12px; font-size: 16px; color: var(--ink); }
  .talk-intro .talk-abstract { margin-top: 20px; font-size: 16px; }
  .slides-section { padding: 44px 0 56px; }
  .slides-section h2, .share-section h2 { font-size: 28px; }
  .slides-description { margin: 18px 0 0; color: var(--muted); }
  .slides-actions { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin: 24px 0 30px; }
  .slides-actions .button { margin-top: 0; font-size: 16px; }
  .text-link { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .slides-preview summary { cursor: pointer; color: var(--accent); }
  .slides-preview object { display: block; width: 100%; height: min(70vh, 760px); margin-top: 20px; border: 1px solid var(--line); }
  .share-section { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding: 44px 0; }
  .share-section p { margin: 18px 0 12px; color: var(--muted); }
  .page-url { overflow-wrap: anywhere; }
  .page-qr { flex-shrink: 0; width: 200px; height: 200px; }
  .qr-download { font-size: 14px; }
  @media (max-width: 640px) {
    .share-section { flex-direction: column; align-items: flex-start; }
    .talk-intro { padding-top: 48px; }
  }
</style>
