---
import '../styles/global.css';
import { suugakuto10 as talk } from '../data/suugakuto-10';

interface Props {
  title: string;
  description: string;
  english?: boolean;
}

const { title, description, english = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<!doctype html>
<html lang={english ? 'en' : 'ja'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <span class="wordmark">{english ? 'Presentation slides' : '発表資料'}</span>
        <div class="language-switch" aria-label="Language switcher">
          <a class:list={{ active: !english }} href={withBase(talk.pagePath)} lang="ja">日本語</a>
          <span aria-hidden="true">/</span>
          <a class:list={{ active: english }} href={withBase(`/en${talk.pagePath}`)} lang="en">EN</a>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Alwe</span>
      </footer>
    </div>
  </body>
</html>
